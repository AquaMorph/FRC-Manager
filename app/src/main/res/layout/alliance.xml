<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_spacing"
    android:layout_marginEnd="@dimen/card_spacing"
    android:layout_marginBottom="@dimen/card_spacing"
    android:background="@drawable/bg_award_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_alliance_stripe"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/alliance_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:textColor="?attr/textOnBackground"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Alliance 1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/alliance_roster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include android:id="@+id/team_1" layout="@layout/item_alliance_team" />
        <include android:id="@+id/team_2" layout="@layout/item_alliance_team" />
        <include android:id="@+id/team_3" layout="@layout/item_alliance_team" />
        <include android:id="@+id/team_4" layout="@layout/item_alliance_team" />
    </LinearLayout>
</LinearLayout>
