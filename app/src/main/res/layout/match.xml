<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/schedule_card_side_margin"
        android:layout_marginEnd="@dimen/schedule_card_side_margin"
        android:layout_marginBottom="@dimen/schedule_card_spacing"
        android:background="@drawable/bg_schedule_match_card"
        android:baselineAligned="false"
        android:clipToOutline="true"
        android:foreground="@drawable/outline_schedule_match_card"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/match_number"
            style="@style/CompactNumber.ScheduleMatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="15"
            android:foreground="?android:attr/selectableItemBackground"
            android:textColor="?textOnBackground"
            tools:text="QM-123" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="35"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/schedule_alliance_height"
                android:background="?scheduleRedSurface"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/red_team_1"
                    style="@style/CompactNumber.ScheduleTeam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?scheduleRedInk"
                    tools:text="254" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/red_team_2"
                    style="@style/CompactNumber.ScheduleTeam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?scheduleRedInk"
                    tools:text="1678" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/red_team_3"
                    style="@style/CompactNumber.ScheduleTeam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?scheduleRedInk"
                    tools:text="10023" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/schedule_alliance_height"
                android:background="?scheduleBlueSurface"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/blue_team_1"
                    style="@style/CompactNumber.ScheduleTeam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?scheduleBlueInk"
                    tools:text="254" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/blue_team_2"
                    style="@style/CompactNumber.ScheduleTeam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?scheduleBlueInk"
                    tools:text="1678" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/blue_team_3"
                    style="@style/CompactNumber.ScheduleTeam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?scheduleBlueInk"
                    tools:text="10023" />
            </LinearLayout>
        </LinearLayout>

        <!-- The time and score share a column, so posting a result never resizes the teams. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="19">

            <LinearLayout
                android:id="@+id/match_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/match_time"
                    style="@style/CompactNumber.ScheduleStatus"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/schedule_alliance_height"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="?textOnBackground"
                    tools:text="08:59 PM" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/prediction"
                    style="@style/CompactNumber.ScheduleStatus"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/schedule_alliance_height"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="?textOnBackground"
                    tools:text="Likely blue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/score_table"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/red_score"
                    style="@style/CompactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/schedule_alliance_height"
                    android:background="?scheduleRedSurface"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="6dp"
                    android:textColor="?scheduleRedInk"
                    tools:text="&#8226;&#8226;&#8226; 123" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/blue_score"
                    style="@style/CompactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/schedule_alliance_height"
                    android:background="?scheduleBlueSurface"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="6dp"
                    android:textColor="?scheduleBlueInk"
                    tools:text="123" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
