<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?cardBackground"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/match_number"
            style="@style/CompactNumber"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="sans-serif-condensed"
            android:textColor="?textOnBackground"
            android:textStyle="bold"
            tools:text="QM-123" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/schedule_alliance_height"
                android:background="?redAllianceBackground"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/red_team_1"
                    style="@style/CompactNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?redAllianceText"
                    tools:text="254" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/red_team_2"
                    style="@style/CompactNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?redAllianceText"
                    tools:text="1678" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/red_team_3"
                    style="@style/CompactNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?redAllianceText"
                    tools:text="10023" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/schedule_alliance_height"
                android:background="?blueAllianceBackground"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/blue_team_1"
                    style="@style/CompactNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?blueAllianceText"
                    tools:text="254" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/blue_team_2"
                    style="@style/CompactNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?blueAllianceText"
                    tools:text="1678" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/blue_team_3"
                    style="@style/CompactNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="?blueAllianceText"
                    tools:text="10023" />
            </LinearLayout>
        </LinearLayout>

        <!-- The time and score share a column, so posting a result never resizes the teams. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.65">

            <LinearLayout
                android:id="@+id/match_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/match_time"
                    style="@style/CompactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="?textOnBackground"
                    tools:text="08:59 PM" />

                <TextView
                    android:id="@+id/prediction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="?textOnBackground"
                    android:textSize="12sp"
                    tools:text="Likely blue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/score_table"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/red_score"
                    style="@style/CompactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/schedule_alliance_height"
                    android:background="?redAllianceBackground"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="8dp"
                    android:textColor="?redAllianceText"
                    tools:text="123" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/blue_score"
                    style="@style/CompactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/schedule_alliance_height"
                    android:background="?blueAllianceBackground"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="8dp"
                    android:textColor="?blueAllianceText"
                    tools:text="123" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
