<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_award_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/award_art"
            android:layout_width="46dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_award_plaque" />

        <TextView
            android:id="@+id/award_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/textOnBackground"
            android:textSize="18sp"
            tools:text="Excellence in Engineering Award" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/award_recipients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
